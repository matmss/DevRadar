# Backend URL (inlined into the bundle at build time; nothing secret belongs in this file).
REACT_APP_API_URL=http://localhost:3333

# Deploying the production build: GitHub sign-in returns to <web origin>/auth/callback, so the
# web server must serve index.html for unknown paths (SPA fallback), e.g. nginx
# `try_files $uri /index.html`, Netlify `/* /index.html 200`, or `serve -s build`. Without it
# the callback is a 404 and sign-in cannot finish. The web origin must also be listed in the
# backend's CORS_ORIGINS. See dev/docs/00-architecture.md, Web.
