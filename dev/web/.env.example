# Backend URL. Vite inlines it into the bundle when the dev server starts or `npm run build`
# runs, so restart `npm start` (or rebuild) after changing it. Only VITE_-prefixed variables reach
# the browser, and anything here ends up in public JavaScript: nothing secret belongs in this file.
# REACT_APP_API_URL (the Create React App name) is no longer read.
VITE_API_URL=http://localhost:3333

# Deploying the production build: GitHub sign-in returns to <web origin>/auth/callback, so the
# web server must serve index.html for unknown paths (SPA fallback), e.g. nginx
# `try_files $uri /index.html`, Netlify `/* /index.html 200`, or `serve -s build`. Without it
# the callback is a 404 and sign-in cannot finish. `npm start` and `npm run preview` already do
# this. The web origin must also be listed in the backend's CORS_ORIGINS. See
# dev/docs/00-architecture.md, Web.
