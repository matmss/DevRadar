{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.matmss.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "DevRadar uses your location to center the map and find nearby developers."
      }
    },
    "android": {
      "package": "com.matmss.mobile"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DevRadar uses your location to center the map and find nearby developers."
        }
      ]
    ]
  }
}
