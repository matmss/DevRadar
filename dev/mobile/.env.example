# Backend base URL, inlined at build time (restart the bundler after changing it). On a device or
# emulator use an address it can reach, e.g. http://10.0.2.2:3333 (Android emulator) or your
# machine's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:3333

# GitHub sign-in (dev/docs/03-auth-spec.md, US-7) returns to the app through the custom scheme
# com.matmss.mobile://auth/callback. The scheme is fixed in app.json ("scheme") and
# src/config.js (APP_SCHEME), not here; the backend's MOBILE_APP_SCHEME must have the same value
# (its default). Sign-in needs a development build (npm run android / ios): Expo Go's exp://
# scheme is refused by the backend on purpose.
