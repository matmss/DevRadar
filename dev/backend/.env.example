MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
PORT=3333
# Browser origins allowed to call the API (comma-separated). Native mobile requests send no
# Origin header and are unaffected. Defaults to the CRA web app and Expo web dev servers.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
