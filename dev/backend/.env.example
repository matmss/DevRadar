MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
PORT=3333
# Browser origins allowed to call the API (comma-separated). Native mobile requests send no
# Origin header and are unaffected. Defaults to the CRA web app and Expo web dev servers.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# GitHub sign-in (dev/docs/03-auth-spec.md). Register a GitHub OAuth App whose callback URL is
# GITHUB_CALLBACK_URL. Required when NODE_ENV=production: the server refuses to start without
# them. Left empty here on purpose; until they are set, GET /auth/github answers 503.
# Keep these out of web/mobile bundles and logs.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3333/auth/github/callback
# Signs DevRadar session tokens (7-day JWTs). Use a long random value, at least 32 characters in
# production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty outside production, a random per-process secret is used (sessions reset on restart).
JWT_SECRET=
# Custom URL scheme of the mobile app, allowed as a post-login redirect
# (com.matmss.mobile://auth/callback). Must equal "scheme" in dev/mobile/app.json (the app's
# applicationId / bundle identifier, reverse-domain per RFC 8252 7.1); also the default.
# Browser redirect targets are allowed for the CORS_ORIGINS above. Must look like "devradar" or
# "com.devradar.app" (lowercase letters/digits, dot- or hyphen-separated). Web/OS schemes
# (http, https, intent, exp, exps, javascript, data, file, ...) are refused, so Expo Go (exp://)
# cannot complete sign-in: use a development build. A refused or invalid value disables mobile
# redirects, with a warning at startup. Empty = disabled.
MOBILE_APP_SCHEME=com.matmss.mobile
# Optional: requests per IP per 15 minutes to the sign-in endpoints (GET /auth/github, the
# callback, POST /auth/token; default 60) and to GET /auth/me (default 600).
# AUTH_RATE_LIMIT_MAX=60
# AUTH_SESSION_RATE_LIMIT_MAX=600
# Optional: PUT/DELETE /devs/me requests per signed-in GitHub account per 15 minutes (default 30).
# PROFILE_RATE_LIMIT_MAX=30

# Express "trust proxy": whether the client IP (and so the rate-limit key) is read from
# X-Forwarded-For. Default off (empty): use the socket address, so clients cannot spoof it.
# Behind a reverse proxy set the number of proxy hops (e.g. 1), or a comma-separated list of
# trusted proxy addresses/subnets (e.g. loopback,10.0.0.0/8). "true" trusts every hop: only
# use it if the proxy overwrites X-Forwarded-For. An invalid address stops the server at start.
TRUST_PROXY=
