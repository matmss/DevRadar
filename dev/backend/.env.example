MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
PORT=3333
# Browser origins allowed to call the API (comma-separated). Native mobile requests send no
# Origin header and are unaffected. Defaults to the CRA web app and Expo web dev servers.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# GitHub sign-in (dev/docs/03-auth-spec.md). Register a GitHub OAuth App whose callback URL is
# GITHUB_CALLBACK_URL. Required when NODE_ENV=production: the server refuses to start without
# them. Left empty here on purpose; until they are set, GET /auth/github answers 503.
# Keep these out of web/mobile bundles and logs.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3333/auth/github/callback
# Signs DevRadar session tokens (7-day JWTs). Use a long random value, at least 32 characters in
# production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty outside production, a random per-process secret is used (sessions reset on restart).
JWT_SECRET=
# Custom URL scheme of the mobile app, allowed as a post-login redirect (devradar://...).
# Browser redirect targets are allowed for the CORS_ORIGINS above.
MOBILE_APP_SCHEME=devradar
# Optional: requests per IP per 15 minutes to /auth/* (default 60).
# AUTH_RATE_LIMIT_MAX=60
