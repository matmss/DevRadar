{
  "name": "devradar-backend-tests",
  "version": "1.0.0",
  "private": true,
  "description": "BDD (Cucumber.js) functional & integration tests for the DevRadar backend (Express/MongoDB/Socket.io).",
  "scripts": {
    "test": "cucumber-js",
    "test:smoke": "cucumber-js --tags '@smoke'",
    "test:regression": "cucumber-js --tags '@regression'",
    "test:ci": "cucumber-js --format json:../reports/backend.json --format progress",
    "unit": "jest --config jest.config.js"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "chai": "^4.4.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.2",
    "nock": "^13.5.5",
    "semver": "^7.8.6",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.3.2"
  }
}
